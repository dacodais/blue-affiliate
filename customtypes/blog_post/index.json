{
  "id": "blog_post",
  "label": "Blog Post",
  "repeatable": true,
  "status": true,
  "format": "page",
  "json": {
    "Main": {
      "uid": {
        "type": "UID",
        "config": {
          "label": "UID"
        }
      },
      "title": {
        "type": "Text",
        "config": {
          "label": "Title"
        }
      },
      "description": {
        "type": "Text",
        "config": {
          "label": "Description"
        }
      },
      "image": {
        "type": "Image",
        "config": {
          "label": "Image"
        }
      },
      "category": {
        "type": "Link",
        "config": {
          "label": "Category",
          "select": "document",
          "customtypes": [
            {
              "id": "blog_category",
              "fields": [
                "name"
              ]
            }
          ]
        }
      },
      "published_date": {
        "type": "Date",
        "config": {
          "label": "Published Date"
        }
      },
      "slices": {
        "type": "Slices",
        "fieldset": "Slice Zone",
        "config": {
          "choices": {
            "rich_text": {
              "type": "SharedSlice"
            }
          }
        }
      }
    }
  }
}